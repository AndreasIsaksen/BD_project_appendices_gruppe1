{"paragraphs":[{"text":"%md\n# Movielens \n### Ref. '2.3 analysis using the Movielens dataset'\nThis notebook covers the following elements:\n- importing the needed packages and reading the Movielens dataset into dataframes.\n- ","user":"anonymous","dateUpdated":"2025-12-14T22:25:25+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h1>Movielens</h1>\n<h3>Ref. &lsquo;2.3 analysis using the Movielens dataset&rsquo;</h3>\n<p>This notebook covers the following elements:</p>\n<ul>\n<li>importing the needed packages and reading the Movielens dataset into dataframes.</li>\n<li></li>\n</ul>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098610_2047128522","id":"paragraph_1765558912907_771494681","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","focus":false,"dateFinished":"2025-12-14T22:25:26+0000","dateStarted":"2025-12-14T22:25:25+0000"},{"text":"%md\r\n### Importing packages and loading data into dataframes\r\nHere the packages needed for the analysis of the movielens dataset are imported.\r\nThe dataset is loaded into seperate dataframes","user":"anonymous","dateUpdated":"2025-12-14T22:41:19+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Importing packages and loading data into dataframes</h3>\n<p>Here the packages needed for the analysis of the movielens dataset are imported.<br />\nThe dataset is loaded into seperate dataframes</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098613_1293083838","id":"paragraph_1765557329589_1585124457","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:41:19+0000","dateStarted":"2025-12-14T22:41:19+0000","focus":false},{"text":"// import av nødvendige funksjoner og lesing av dataset\r\nimport org.apache.spark.sql.types._\r\nimport org.apache.spark.sql.DataFrame\r\nimport org.apache.spark.sql.functions._\r\nimport scala.math._\r\nimport org.apache.spark.sql.expressions.Window\r\n\r\nval movies = spark.read\r\n    .format(\"csv\")\r\n    .option(\"header\", true)\r\n    .option(\"inferSchema\", true)\r\n    .load(\"/sparkio/ml-32m/movies.csv\")\r\n\r\nval ratings = spark.read\r\n    .format(\"csv\")\r\n    .option(\"header\", true)\r\n    .option(\"inferSchema\", true)\r\n    .load(\"/sparkio/ml-32m/ratings.csv\")\r\n\r\nval tags = spark.read\r\n    .format(\"csv\")\r\n    .option(\"header\", true)\r\n    .option(\"inferSchema\", true)\r\n    .load(\"/sparkio/ml-32m/tags.csv\")","user":"anonymous","dateUpdated":"2025-12-14T22:28:40+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"import org.apache.spark.sql.types._\nimport org.apache.spark.sql.DataFrame\nimport org.apache.spark.sql.functions._\nimport scala.math._\nimport org.apache.spark.sql.expressions.Window\n\u001b[1m\u001b[34mmovies\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [movieId: int, title: string ... 1 more field]\n\u001b[1m\u001b[34mratings\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [userId: int, movieId: int ... 2 more fields]\n\u001b[1m\u001b[34mtags\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [userId: int, movieId: int ... 2 more fields]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=36"},{"jobUrl":"http://localhost:4040/jobs/job?id=37"},{"jobUrl":"http://localhost:4040/jobs/job?id=38"},{"jobUrl":"http://localhost:4040/jobs/job?id=39"},{"jobUrl":"http://localhost:4040/jobs/job?id=40"},{"jobUrl":"http://localhost:4040/jobs/job?id=41"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098614_1465593883","id":"paragraph_1758651599899_1219238674","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:28:39+0000","dateStarted":"2025-12-14T22:27:25+0000"},{"text":"%md\n### Validating the dataframes\nThe dataframes for movies, ratings and tags is printed and counted for validation","user":"anonymous","dateUpdated":"2025-12-14T22:28:47+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Validating the dataframes</h3>\n<p>The dataframes for movies, ratings and tags is printed and counted for validation</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098614_491787391","id":"paragraph_1765583825123_1812548937","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:28:47+0000","dateStarted":"2025-12-14T22:28:47+0000"},{"text":"movies.show(5)\r\nratings.show(5)\r\ntags.show(5)\r\n\r\nprint(movies.count(), ratings.count(), tags.count())","user":"anonymous","dateUpdated":"2025-12-14T22:28:47+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"editorHide":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+-------+--------------------+--------------------+\n|movieId|               title|              genres|\n+-------+--------------------+--------------------+\n|      1|    Toy Story (1995)|Adventure|Animati...|\n|      2|      Jumanji (1995)|Adventure|Childre...|\n|      3|Grumpier Old Men ...|      Comedy|Romance|\n|      4|Waiting to Exhale...|Comedy|Drama|Romance|\n|      5|Father of the Bri...|              Comedy|\n+-------+--------------------+--------------------+\nonly showing top 5 rows\n\n+------+-------+------+---------+\n|userId|movieId|rating|timestamp|\n+------+-------+------+---------+\n|     1|     17|   4.0|944249077|\n|     1|     25|   1.0|944250228|\n|     1|     29|   2.0|943230976|\n|     1|     30|   5.0|944249077|\n|     1|     32|   5.0|943228858|\n+------+-------+------+---------+\nonly showing top 5 rows\n\n+------+-------+-----------+----------+\n|userId|movieId|        tag| timestamp|\n+------+-------+-----------+----------+\n|    22|  26479|Kevin Kline|1583038886|\n|    22|  79592|   misogyny|1581476297|\n|    22| 247150| acrophobia|1622483469|\n|    34|   2174|      music|1249808064|\n|    34|   2174|      weird|1249808102|\n+------+-------+-----------+----------+\nonly showing top 5 rows\n\n(87585,32000204,2000072)"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=42"},{"jobUrl":"http://localhost:4040/jobs/job?id=43"},{"jobUrl":"http://localhost:4040/jobs/job?id=44"},{"jobUrl":"http://localhost:4040/jobs/job?id=45"},{"jobUrl":"http://localhost:4040/jobs/job?id=46"},{"jobUrl":"http://localhost:4040/jobs/job?id=47"},{"jobUrl":"http://localhost:4040/jobs/job?id=48"},{"jobUrl":"http://localhost:4040/jobs/job?id=49"},{"jobUrl":"http://localhost:4040/jobs/job?id=50"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098614_608419233","id":"paragraph_1758879441648_637952650","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:29:12+0000","dateStarted":"2025-12-14T22:28:47+0000"},{"text":"%md\n### Ref '2.3.2.2 Konvertering av Timestamp til Dato' in report\n#### Converting Timestanmp into Date\nThe section below makes a new dataframe where we convert Timestamp into Date and then drops the timestamp column","user":"anonymous","dateUpdated":"2025-12-14T22:29:12+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Ref &lsquo;2.3.2.2 Konvertering av Timestamp til Dato&rsquo; in report</h3>\n<h4>Converting Timestanmp into Date</h4>\n<p>The section below makes a new dataframe where we convert Timestamp into Date and then drops the timestamp column</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098615_1389994104","id":"paragraph_1765559903174_1329720312","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:29:12+0000","dateStarted":"2025-12-14T22:29:12+0000"},{"text":"// Parse timestamps to rating_date\r\nval ratings_with_date = ratings\r\n    .withColumn(\"rating_date\", to_date(from_unixtime(col(\"timestamp\"))))\r\n    .drop(\"timestamp\")\r\n\r\nratings_with_date.show(5)\r\n","user":"anonymous","dateUpdated":"2025-12-14T22:29:12+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"editorHide":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+------+-------+------+-----------+\n|userId|movieId|rating|rating_date|\n+------+-------+------+-----------+\n|     1|     17|   4.0| 1999-12-03|\n|     1|     25|   1.0| 1999-12-03|\n|     1|     29|   2.0| 1999-11-22|\n|     1|     30|   5.0| 1999-12-03|\n|     1|     32|   5.0| 1999-11-22|\n+------+-------+------+-----------+\nonly showing top 5 rows\n\n\u001b[1m\u001b[34mratings_with_date\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [userId: int, movieId: int ... 2 more fields]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=51"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098616_800811807","id":"paragraph_1758879396825_2007171933","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:29:14+0000","dateStarted":"2025-12-14T22:29:12+0000"},{"text":"%md\n### Ref. '2.3.2.3 Vurdering per dag' in report\n#### Ratings per day\nIn the sections below a new dataframe for ratings per day is created and then counted.\nThe rows are then sorted by descending order. Lastly the first 5 rows are printed to validate the dataframe.","user":"anonymous","dateUpdated":"2025-12-14T22:29:14+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Ref. &lsquo;2.3.2.3 Vurdering per dag&rsquo; in report</h3>\n<h4>Ratings per day</h4>\n<p>In the sections below a new dataframe for ratings per day is created and then counted.<br />\nThe rows are then sorted by descending order. Lastly the first 5 rows are printed to validate the dataframe.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098616_2147321889","id":"paragraph_1765560266383_1621235835","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:29:14+0000","dateStarted":"2025-12-14T22:29:14+0000"},{"text":"// ratings per day\r\nval ratings_per_date = ratings_with_date\r\n    .groupBy(\"rating_date\")\r\n    .count()\r\n    .orderBy(desc(\"count\"))\r\n\r\nratings_per_date.show(5)","user":"anonymous","dateUpdated":"2025-12-14T22:29:14+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"editorHide":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+-----------+-----+\n|rating_date|count|\n+-----------+-----+\n| 2000-11-20|90302|\n| 2005-03-22|72926|\n| 1999-12-11|59798|\n| 2008-10-29|56462|\n| 2000-11-21|54872|\n+-----------+-----+\nonly showing top 5 rows\n\n\u001b[1m\u001b[34mratings_per_date\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [rating_date: date, count: bigint]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=52"},{"jobUrl":"http://localhost:4040/jobs/job?id=53"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098617_917841971","id":"paragraph_1758879520703_46962867","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:30:08+0000","dateStarted":"2025-12-14T22:29:14+0000"},{"text":"%md\n## Ref. '2.3.2.4 Distribusjon av Vurderings Verdier' in report\n### Distribution of rating values\nThe following section a new dataframe for distribution is made and ordered by rating in descending order.","user":"anonymous","dateUpdated":"2025-12-14T22:30:08+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>Ref. &lsquo;2.3.2.4 Distribusjon av Vurderings Verdier&rsquo; in report</h2>\n<h3>Distribution of rating values</h3>\n<p>The following section a new dataframe for distribution is made and ordered by rating in descending order.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098617_1859690236","id":"paragraph_1765560664598_1047425963","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:30:08+0000","dateStarted":"2025-12-14T22:30:08+0000"},{"text":"// distribution of rating values\r\nval rating_distribution = ratings_with_date\r\n    .groupBy(\"rating\")\r\n    .count()\r\n    .orderBy(asc(\"rating\"))\r\n\r\nrating_distribution.show()","user":"anonymous","dateUpdated":"2025-12-14T22:30:08+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"editorHide":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+------+-------+\n|rating|  count|\n+------+-------+\n|   0.5| 525132|\n|   1.0| 946675|\n|   1.5| 531063|\n|   2.0|2028622|\n|   2.5|1685386|\n|   3.0|6054990|\n|   3.5|4290105|\n|   4.0|8367654|\n|   4.5|2974000|\n|   5.0|4596577|\n+------+-------+\n\n\u001b[1m\u001b[34mrating_distribution\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [rating: double, count: bigint]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=54"},{"jobUrl":"http://localhost:4040/jobs/job?id=55"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098617_1368490874","id":"paragraph_1758879629018_464899813","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:30:43+0000","dateStarted":"2025-12-14T22:30:08+0000"},{"text":"%md\n### Ref. '2.3.2.5 Brukere med ≥ N Vurderinger' in report\n#### Users with ≥N ratings\nin this section a new dataframe for ratings per user is made. It is grouped by userId and then counted.\nA function with input parameters 'N' is defined, where 'N' is the amount of ratings to sort by. This functions returns a dataframe with users who have made 'N' or more ratings.\nThe first 5 rows of the dataframe are then printed to validate the results.","user":"anonymous","dateUpdated":"2025-12-14T22:30:43+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Ref. &lsquo;2.3.2.5 Brukere med ≥ N Vurderinger&rsquo; in report</h3>\n<h4>Users with ≥N ratings</h4>\n<p>in this section a new dataframe for ratings per user is made. It is grouped by userId and then counted.<br />\nA function with input parameters &lsquo;N&rsquo; is defined, where &lsquo;N&rsquo; is the amount of ratings to sort by. This functions returns a dataframe with users who have made &lsquo;N&rsquo; or more ratings.<br />\nThe first 5 rows of the dataframe are then printed to validate the results.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098617_1368853091","id":"paragraph_1765560883631_165914858","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:30:43+0000","dateStarted":"2025-12-14T22:30:43+0000"},{"text":"// users with ≥ N ratings\r\nval ratings_per_user = ratings_with_date\r\n    .groupBy(\"userId\")\r\n    .count()\r\n    \r\ndef users_with_N_ratings(N: Int): DataFrame = {\r\n    val returnDf = ratings_per_user.where($\"count\" >= N).orderBy(asc(\"count\"))\r\n    returnDf\r\n}\r\nusers_with_N_ratings(19).show(5)","user":"anonymous","dateUpdated":"2025-12-14T22:30:43+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"editorHide":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+------+-----+\n|userId|count|\n+------+-----+\n| 59955|   20|\n|  3698|   20|\n| 37183|   20|\n|  1699|   20|\n| 56307|   20|\n+------+-----+\nonly showing top 5 rows\n\n\u001b[1m\u001b[34mratings_per_user\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [userId: int, count: bigint]\n\u001b[1m\u001b[34musers_with_N_ratings\u001b[0m: \u001b[1m\u001b[32m(N: Int)org.apache.spark.sql.DataFrame\u001b[0m\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=56"},{"jobUrl":"http://localhost:4040/jobs/job?id=57"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098618_139053784","id":"paragraph_1758651640980_464729385","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:31:15+0000","dateStarted":"2025-12-14T22:30:43+0000"},{"text":"%md\n### Ref. '2.3.3.1 Top Movies Rangert på Antall Vurdering med Minst 100 Vurderinger' in report\n#### Top movies ranked by the amount of ratings with more than 1000 ratings\nTop movies ranked by amount of ratings, with the minimun amount of ratings is 100.\nIn this section a new dataframe for ratingsWithCountPerMovie is made and ordered by movieId and is counted.\nThe dataframe is then joined with with the movie dataframe for all the rows with a corresponding movieId.\nThis is then inserted into a new dataframe for moviesWithRatingCount with only the wanted columns. Then all movies with less than 100 ratings are removed.\nThe dataframe are then ordered by amount of ratings by descending order and then printed. \n","user":"anonymous","dateUpdated":"2025-12-14T22:31:15+0000","progress":0,"config":{"tableHide":true,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Ref. &lsquo;2.3.3.1 Top Movies Rangert på Antall Vurdering med Minst 100 Vurderinger&rsquo; in report</h3>\n<h4>Top movies ranked by the amount of ratings with more than 1000 ratings</h4>\n<p>Top movies ranked by amount of ratings, with the minimun amount of ratings is 100.<br />\nIn this section a new dataframe for ratingsWithCountPerMovie is made and ordered by movieId and is counted.<br />\nThe dataframe is then joined with with the movie dataframe for all the rows with a corresponding movieId.<br />\nThis is then inserted into a new dataframe for moviesWithRatingCount with only the wanted columns. Then all movies with less than 100 ratings are removed.<br />\nThe dataframe are then ordered by amount of ratings by descending order and then printed.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098618_182973183","id":"paragraph_1765561459982_665305610","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:31:15+0000","dateStarted":"2025-12-14T22:31:15+0000"},{"text":"// Top movies by rating count (min 100 ratings)\r\nval ratings_with_count_per_movie = ratings.groupBy(\"movieId\").count()\r\nval join_ex1 = movies.col(\"movieId\") === ratings_with_count_per_movie.col(\"movieId\")\r\nval movies_with_rating_count = movies.join(ratings_with_count_per_movie, join_ex1)\r\n    .where($\"count\" >= 100)\r\n    .select(movies(\"movieId\"), movies(\"title\"), movies(\"genres\"), ratings_with_count_per_movie(\"count\"))\r\n    .orderBy(desc(\"count\"))\r\n\r\nmovies_with_rating_count.show(5)","user":"anonymous","dateUpdated":"2025-12-14T22:31:15+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"editorHide":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+-------+--------------------+--------------------+------+\n|movieId|               title|              genres| count|\n+-------+--------------------+--------------------+------+\n|    318|Shawshank Redempt...|         Crime|Drama|102929|\n|    356| Forrest Gump (1994)|Comedy|Drama|Roma...|100296|\n|    296| Pulp Fiction (1994)|Comedy|Crime|Dram...| 98409|\n|   2571|  Matrix, The (1999)|Action|Sci-Fi|Thr...| 93808|\n|    593|Silence of the La...|Crime|Horror|Thri...| 90330|\n+-------+--------------------+--------------------+------+\nonly showing top 5 rows\n\n\u001b[1m\u001b[34mratings_with_count_per_movie\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [movieId: int, count: bigint]\n\u001b[1m\u001b[34mjoin_ex1\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Column\u001b[0m = (movieId = movieId)\n\u001b[1m\u001b[34mmovies_with_rating_count\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [movieId: int, title: string ... 2 more fields]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=58"},{"jobUrl":"http://localhost:4040/jobs/job?id=59"},{"jobUrl":"http://localhost:4040/jobs/job?id=60"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098618_481614886","id":"paragraph_1758881996950_1685138731","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:31:51+0000","dateStarted":"2025-12-14T22:31:15+0000"},{"text":"%md\n### Ref. '2.3.3.2 Vektet Bayesian Vurdering og Topp 20 Movie Liste med Både Gjennomsnitt og Bayesian Verdi'\n#### Weighted bayesian ratings and top 20 movies lists with average and bayesian values\nIn this section a new datafrane ratingsWithAvg is made where we take the average of ratingsWithDate grouped by MovieId and count the number of ratings per movieId.\nA variable containing the global average of all ratings is made for use in further operations.\nA dataframe for ratingsBayScore is made with ratingsWithAvg where a new column with calculation of bayesian score for the movies, then a join expression is used to combine the movies dataframe and rating_bay_score datafram for all corresponding entries where movieId match","user":"anonymous","dateUpdated":"2025-12-14T22:31:51+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Ref. &lsquo;2.3.3.2 Vektet Bayesian Vurdering og Topp 20 Movie Liste med Både Gjennomsnitt og Bayesian Verdi&rsquo;</h3>\n<h4>Weighted bayesian ratings and top 20 movies lists with average and bayesian values</h4>\n<p>In this section a new datafrane ratingsWithAvg is made where we take the average of ratingsWithDate grouped by MovieId and count the number of ratings per movieId.<br />\nA variable containing the global average of all ratings is made for use in further operations.<br />\nA dataframe for ratingsBayScore is made with ratingsWithAvg where a new column with calculation of bayesian score for the movies, then a join expression is used to combine the movies dataframe and rating_bay_score datafram for all corresponding entries where movieId match</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098619_2041976557","id":"paragraph_1765575642354_106734915","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:31:51+0000","dateStarted":"2025-12-14T22:31:51+0000"},{"text":"// top-20 table with both averages and the Bayesian score\r\nval ratings_with_avg = ratings_with_date.groupBy(\"movieId\")\r\n    .agg(\r\n        format_number(avg(\"rating\"), 2).as(\"avg_rating\"),\r\n        count(\"rating\").as(\"rating_count\")\r\n    )\r\n\r\nval global_avg_rating = ratings_with_date.select(avg(\"rating\")).first()\r\nval ratings_bay_score = ratings_with_avg\r\n    .withColumn(\"bayesian_rating\", format_number((($\"rating_count\" / ($\"rating_count\" + 100)) * $\"avg_rating\") + (lit(100) / ($\"rating_count\" + 100)) * global_avg_rating(0),2))\r\nval join_ex2 = movies.col(\"movieId\") === ratings_bay_score.col(\"movieId\")\r\nval movies_with_rating = movies.join(ratings_bay_score, join_ex2).where($\"rating_count\" >= 100)\r\n    .select(movies(\"movieId\"), movies(\"title\"), movies(\"genres\"), ratings_bay_score(\"rating_count\"), ratings_bay_score(\"avg_rating\"), ratings_bay_score(\"bayesian_rating\"))\r\n    .orderBy($\"avg_rating\".desc, $\"bayesian_rating\".desc)\r\n    .limit(20)\r\nmovies_with_rating.show(30)","user":"anonymous","dateUpdated":"2025-12-14T22:31:51+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"editorHide":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+-------+--------------------+--------------------+------------+----------+---------------+\n|movieId|               title|              genres|rating_count|avg_rating|bayesian_rating|\n+-------+--------------------+--------------------+------------+----------+---------------+\n| 171011|Planet Earth II (...|         Documentary|        1956|      4.45|           4.41|\n| 159817| Planet Earth (2006)|         Documentary|        2948|      4.44|           4.41|\n| 170705|Band of Brothers ...|    Action|Drama|War|        2811|      4.43|           4.40|\n|    318|Shawshank Redempt...|         Crime|Drama|      102929|      4.40|           4.40|\n| 171495|              Cosmos|  (no genres listed)|         615|      4.33|           4.22|\n|    858|Godfather, The (1...|         Crime|Drama|       66440|      4.32|           4.32|\n| 202439|     Parasite (2019)|        Comedy|Drama|       11670|      4.31|           4.30|\n| 179135|Blue Planet II (2...|         Documentary|        1163|      4.30|           4.24|\n| 198185|   Twin Peaks (1989)|       Drama|Mystery|        1140|      4.30|           4.24|\n| 220528|Twelve Angry Men ...|               Drama|         449|      4.29|           4.15|\n|   1203| 12 Angry Men (1957)|               Drama|       21863|      4.27|           4.27|\n|     50|Usual Suspects, T...|Crime|Mystery|Thr...|       67750|      4.27|           4.27|\n|   1221|Godfather: Part I...|         Crime|Drama|       43111|      4.26|           4.26|\n| 163809|Over the Garden W...|Adventure|Animati...|        1397|      4.26|           4.21|\n|   2019|Seven Samurai (Sh...|Action|Adventure|...|       16531|      4.25|           4.25|\n| 142115|The Blue Planet (...|         Documentary|        1061|      4.25|           4.19|\n| 182723|Cosmos: A Spaceti...|  (no genres listed)|         594|      4.25|           4.15|\n|    527|Schindler's List ...|           Drama|War|       73849|      4.24|           4.24|\n| 166024|     Whiplash (2013)|  (no genres listed)|        3080|      4.24|           4.22|\n|    904|  Rear Window (1954)|    Mystery|Thriller|       24883|      4.23|           4.23|\n+-------+--------------------+--------------------+------------+----------+---------------+\n\n\u001b[1m\u001b[34mratings_with_avg\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [movieId: int, avg_rating: string ... 1 more field]\n\u001b[1m\u001b[34mglobal_avg_rating\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Row\u001b[0m = [3.5403956487277393]\n\u001b[1m\u001b[34mratings_bay_score\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [movieId: int, avg_rating: string ... 2 more fields]\n\u001b[1m\u001b[34mjoin_ex2\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Column\u001b[0m = (movieId = movieId)\n\u001b[1m\u001b[34mmovies_with_rating\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [movieId: int, title: string ... 4 more fields]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=61"},{"jobUrl":"http://localhost:4040/jobs/job?id=62"},{"jobUrl":"http://localhost:4040/jobs/job?id=63"},{"jobUrl":"http://localhost:4040/jobs/job?id=64"},{"jobUrl":"http://localhost:4040/jobs/job?id=65"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098619_2023949109","id":"paragraph_1758652145500_1110142296","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:33:03+0000","dateStarted":"2025-12-14T22:31:51+0000"},{"text":"%md\n## 2.3.5 Tags and Texty Aggregation","user":"anonymous","dateUpdated":"2025-12-14T22:33:03+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>2.3.5 Tags and Texty Aggregation</h2>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098619_41143187","id":"paragraph_1765577153756_42314601","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:33:03+0000","dateStarted":"2025-12-14T22:33:03+0000"},{"text":"%md\n### Ref. '2.3.4.1 For Hver Movie Tell Hvor Mange Ganger en Spesifikk Tag Finnes' in report\n#### How many times does a spesific tag appear for each movie\nin this section we made a new dataframe for tags_With_Counts with tags and grouped on movieId and Tag, and then printed for validation.","user":"anonymous","dateUpdated":"2025-12-14T22:33:03+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Ref. &lsquo;2.3.4.1 For Hver Movie Tell Hvor Mange Ganger en Spesifikk Tag Finnes&rsquo; in report</h3>\n<h4>How many times does a spesific tag appear for each movie</h4>\n<p>in this section we made a new dataframe for tags_With_Counts with tags and grouped on movieId and Tag, and then printed for validation.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098619_1399380493","id":"paragraph_1765577241732_689977485","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:33:03+0000","dateStarted":"2025-12-14T22:33:03+0000"},{"text":"// For each movieId, count how often each tag appears\r\nval tags_with_count = tags.groupBy(\"movieId\", \"tag\").count()\r\ntags_with_count.show(5)","user":"anonymous","dateUpdated":"2025-12-14T22:33:03+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"editorHide":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+-------+-----------------+-----+\n|movieId|              tag|count|\n+-------+-----------------+-----+\n| 102407|    disappointing|   20|\n|  55247|       sad ending|    7|\n| 106100|social commentary|   46|\n|   8368|     Alan Rickman|   12|\n|  30810|       Soundtrack|    1|\n+-------+-----------------+-----+\nonly showing top 5 rows\n\n\u001b[1m\u001b[34mtags_with_count\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [movieId: int, tag: string ... 1 more field]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=66"},{"jobUrl":"http://localhost:4040/jobs/job?id=67"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098620_876522024","id":"paragraph_1758886649149_1449499221","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:33:09+0000","dateStarted":"2025-12-14T22:33:03+0000"},{"text":"%md\n### Ref. '2.3.4.2 Top Tags for Hver Movie' in report\n#### top tags for each movie\nA variable for the amount of Movies is made and is then converted to a double for later operations. Then a variable for movies with one or more tags are made.\nTo get the value for this variable  movies_with_tags is grouped by movieId and counted, then the number of rows are counted to get the number of movies with atleast one tag. This is also convered to a double.\na new dataframe is made for top_tags where a new column min_tag_freq is added to tags_with_count and is ordered descending by the amount of times a specific tag occures.\n- .toDouble(), casts a value to a Double\n- .log10() gets the tenth log of a number value","user":"anonymous","dateUpdated":"2025-12-14T22:33:09+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Ref. &lsquo;2.3.4.2 Top Tags for Hver Movie&rsquo; in report</h3>\n<h4>top tags for each movie</h4>\n<p>A variable for the amount of Movies is made and is then converted to a double for later operations. Then a variable for movies with one or more tags are made.<br />\nTo get the value for this variable  movies_with_tags is grouped by movieId and counted, then the number of rows are counted to get the number of movies with atleast one tag. This is also convered to a double.<br />\na new dataframe is made for top_tags where a new column min_tag_freq is added to tags_with_count and is ordered descending by the amount of times a specific tag occures.</p>\n<ul>\n<li>.toDouble(), casts a value to a Double</li>\n<li>.log10() gets the tenth log of a number value</li>\n</ul>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098620_485128382","id":"paragraph_1765578843649_1957017606","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:33:09+0000","dateStarted":"2025-12-14T22:33:09+0000"},{"text":"import scala.math._\r\n// top tags per movie (min tag frequency)\r\nval total_movies = movies.count().toDouble\r\nval movies_with_tag = tags.groupBy(\"movieId\").count().count().toDouble\r\nval top_tags = tags_with_count.withColumn(\"min_tag_freq\", format_number($\"count\" * (log10(total_movies / movies_with_tag)),2))\r\n    .orderBy(desc(\"count\"))\r\n\r\ntop_tags.show(5)","user":"anonymous","dateUpdated":"2025-12-14T22:33:09+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"editorHide":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+-------+-----------------+-----+------------+\n|movieId|              tag|count|min_tag_freq|\n+-------+-----------------+-----+------------+\n|    260|           sci-fi|  596|      138.34|\n|  79132|alternate reality|  360|       83.56|\n|    296|Quentin Tarantino|  355|       82.40|\n|   2959|     twist ending|  347|       80.54|\n|  79132|thought-provoking|  339|       78.69|\n+-------+-----------------+-----+------------+\nonly showing top 5 rows\n\nimport scala.math._\n\u001b[1m\u001b[34mtotal_movies\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 87585.0\n\u001b[1m\u001b[34mmovies_with_tag\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 51323.0\n\u001b[1m\u001b[34mtop_tags\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [movieId: int, tag: string ... 2 more fields]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=68"},{"jobUrl":"http://localhost:4040/jobs/job?id=69"},{"jobUrl":"http://localhost:4040/jobs/job?id=70"},{"jobUrl":"http://localhost:4040/jobs/job?id=71"},{"jobUrl":"http://localhost:4040/jobs/job?id=72"},{"jobUrl":"http://localhost:4040/jobs/job?id=73"},{"jobUrl":"http://localhost:4040/jobs/job?id=74"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098620_2011484183","id":"paragraph_1758718997570_112640948","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:33:22+0000","dateStarted":"2025-12-14T22:33:09+0000"},{"text":"%md\n## 2.3.5 User-level Windows and Cohorts","user":"anonymous","dateUpdated":"2025-12-14T22:33:22+0000","progress":0,"config":{"tableHide":true,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>2.3.5 User-level Windows and Cohorts</h2>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098620_515366082","id":"paragraph_1765580306756_312619865","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:33:22+0000","dateStarted":"2025-12-14T22:33:22+0000"},{"text":"%md\n### Ref. '2.3.5.1 Først og Siste Dato en Bruker Registrerte en Vurdering' in report\n#### First and last date a rating vas registered by a user.\nin this section a new dataframe user_first_last where the dataframe ratings_with_date is grouped on userId. The min and max value is added as new columns.\nTo solve this tassk a package for sql functions is imported. This package is imported here aswell as in the top section to mitigate problems occuring when this section is run.","user":"anonymous","dateUpdated":"2025-12-14T22:33:23+0000","progress":0,"config":{"tableHide":true,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Ref. &lsquo;2.3.5.1 Først og Siste Dato en Bruker Registrerte en Vurdering&rsquo; in report</h3>\n<h4>First and last date a rating vas registered by a user.</h4>\n<p>in this section a new dataframe user_first_last where the dataframe ratings_with_date is grouped on userId. The min and max value is added as new columns.<br />\nTo solve this tassk a package for sql functions is imported. This package is imported here aswell as in the top section to mitigate problems occuring when this section is run.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098621_1413346718","id":"paragraph_1765580362723_2037868656","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:33:23+0000","dateStarted":"2025-12-14T22:33:23+0000"},{"text":"import org.apache.spark.sql.functions._\r\n// Per-user: first/last rating date\r\nval user_first_last = ratings_with_date.groupBy($\"userId\")\r\n    .agg(\r\n        min($\"rating_date\").as(\"first\"),\r\n        max($\"rating_date\").as(\"last\")\r\n    )    \r\n\r\nuser_first_last.show(5)","user":"anonymous","dateUpdated":"2025-12-14T22:33:23+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"editorHide":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+------+----------+----------+\n|userId|     first|      last|\n+------+----------+----------+\n|   148|2016-08-21|2016-08-22|\n|   463|2016-09-25|2016-09-25|\n|   471|1996-08-20|1996-08-20|\n|   496|2021-10-07|2021-10-08|\n|   833|2006-05-17|2009-06-03|\n+------+----------+----------+\nonly showing top 5 rows\n\nimport org.apache.spark.sql.functions._\n\u001b[1m\u001b[34muser_first_last\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [userId: int, first: date ... 1 more field]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=75"},{"jobUrl":"http://localhost:4040/jobs/job?id=76"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098621_1932473521","id":"paragraph_1758704027388_26181558","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:34:21+0000","dateStarted":"2025-12-14T22:33:23+0000"},{"text":"%md\n### Ref. '2.3.5.2 Månedlig Aktivitet med Vurdering per Bruker' in raport\n#### Monthly activity with ratings per user.\nIn this section a new dataframe monthly_activity is made by extracting montly activity and ratings from ratings_with_date.\nThis is done by making a new column for month and then exlusively extracting values for month and year from the rating_Date dataframe. This is then grouped by userId and month.\nit is then printed for validation.","user":"anonymous","dateUpdated":"2025-12-14T22:34:21+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Ref. &lsquo;2.3.5.2 Månedlig Aktivitet med Vurdering per Bruker&rsquo; in raport</h3>\n<h4>Monthly activity with ratings per user.</h4>\n<p>In this section a new dataframe monthly_activity is made by extracting montly activity and ratings from ratings_with_date.<br />\nThis is done by making a new column for month and then exlusively extracting values for month and year from the rating_Date dataframe. This is then grouped by userId and month.<br />\nit is then printed for validation.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098621_1212135831","id":"paragraph_1765581474731_711495297","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:34:21+0000","dateStarted":"2025-12-14T22:34:21+0000"},{"text":"// Per-user: monthly activity\r\nval monthly_activity = ratings_with_date\r\n    .withColumn(\"month\", date_format($\"rating_date\", \"yyyy-MM\"))\r\n    .groupBy($\"userId\", $\"month\")\r\n    .count()\r\n    .orderBy($\"userId\", $\"month\")\r\nmonthly_activity.show()","user":"anonymous","dateUpdated":"2025-12-14T22:34:21+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"editorHide":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+------+-------+-----+\n|userId|  month|count|\n+------+-------+-----+\n|     1|1999-11|   60|\n|     1|1999-12|   81|\n|     2|1996-07|   52|\n|     3|2004-05|  147|\n|     4|2000-06|   27|\n|     5|1996-08|   33|\n|     6|2004-11|   26|\n|     7|1996-08|   44|\n|     8|2019-03|   31|\n|     9|2006-01|   23|\n|     9|2006-02|   18|\n|     9|2006-03|   17|\n|    10|2007-01|  175|\n|    10|2007-02|   15|\n|    10|2007-03|    8|\n|    10|2007-04|   14|\n|    10|2007-05|    5|\n|    10|2007-06|    2|\n|    10|2007-07|    8|\n|    10|2007-08|    2|\n+------+-------+-----+\nonly showing top 20 rows\n\n\u001b[1m\u001b[34mmonthly_activity\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [userId: int, month: string ... 1 more field]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=77"},{"jobUrl":"http://localhost:4040/jobs/job?id=78"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098621_1365542328","id":"paragraph_1758875689244_1897791266","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:35:37+0000","dateStarted":"2025-12-14T22:34:21+0000"},{"text":"%md\n### Ref. '2.3.5.3 Rullende 3 Måneders Telling av Vurdering per Bruker' in report\n#### Rolling 3 months count of ratings per user\nIn this section we reuse the dataframe from an earlier task to make the new dataframe for the rolling 3 month count. This is based on the on the two preceding rows and the current row/month to get the rolling count for 3 rows/months \n\nfunctions:\n- .Window.rowsBetween()\n- .over()","user":"anonymous","dateUpdated":"2025-12-14T22:35:37+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Ref. &lsquo;2.3.5.3 Rullende 3 Måneders Telling av Vurdering per Bruker&rsquo; in report</h3>\n<h4>Rolling 3 months count of ratings per user</h4>\n<p>In this section we reuse the dataframe from an earlier task to make the new dataframe for the rolling 3 month count. This is based on the on the two preceding rows and the current row/month to get the rolling count for 3 rows/months</p>\n<p>functions:</p>\n<ul>\n<li>.Window.rowsBetween()</li>\n<li>.over()</li>\n</ul>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098622_1925162948","id":"paragraph_1765581906422_1607526643","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:35:37+0000","dateStarted":"2025-12-14T22:35:37+0000"},{"text":"//rolling 3-month count (window over time).\r\nval win = Window\r\n    .partitionBy($\"userId\")\r\n    .orderBy($\"month\")\r\n    .rowsBetween(-2, 0)\r\n\r\nval monthly_activity_with_rolling_avg = monthly_activity.withColumn(\"rolling_3_month_count\", sum($\"count\").over(win)).orderBy($\"userId\")\r\n\r\nmonthly_activity_with_rolling_avg.show()","user":"anonymous","dateUpdated":"2025-12-14T22:35:37+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"editorHide":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+------+-------+-----+---------------------+\n|userId|  month|count|rolling_3_month_count|\n+------+-------+-----+---------------------+\n|     1|1999-11|   60|                   60|\n|     1|1999-12|   81|                  141|\n|     2|1996-07|   52|                   52|\n|     3|2004-05|  147|                  147|\n|     4|2000-06|   27|                   27|\n|     5|1996-08|   33|                   33|\n|     6|2004-11|   26|                   26|\n|     7|1996-08|   44|                   44|\n|     8|2019-03|   31|                   31|\n|     9|2006-01|   23|                   23|\n|     9|2006-02|   18|                   41|\n|     9|2006-03|   17|                   58|\n|    10|2007-01|  175|                  175|\n|    10|2007-02|   15|                  190|\n|    10|2007-03|    8|                  198|\n|    10|2007-04|   14|                   37|\n|    10|2007-05|    5|                   27|\n|    10|2007-06|    2|                   21|\n|    10|2007-07|    8|                   15|\n|    10|2007-08|    2|                   12|\n+------+-------+-----+---------------------+\nonly showing top 20 rows\n\n\u001b[1m\u001b[34mwin\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.expressions.WindowSpec\u001b[0m = org.apache.spark.sql.expressions.WindowSpec@1c987b6\n\u001b[1m\u001b[34mmonthly_activity_with_rolling_avg\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [userId: int, month: string ... 2 more fields]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=79"},{"jobUrl":"http://localhost:4040/jobs/job?id=80"},{"jobUrl":"http://localhost:4040/jobs/job?id=81"},{"jobUrl":"http://localhost:4040/jobs/job?id=82"},{"jobUrl":"http://localhost:4040/jobs/job?id=83"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098622_845498049","id":"paragraph_1758870007016_1602582137","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:36:56+0000","dateStarted":"2025-12-14T22:35:37+0000"},{"text":"%md\n### Ref. '2.3.5.4 Bruker Kohorter Oppdelt på Første Måned med en Registrert Vurdering' in raport.\n#### User cohorts segmented by first month with a registered rating.\nin this section a new dataframe for cohorts_first is made by taking the dataframe user_first_last and adding a new column first_month, where the date value in first is converted to contain only year and month.\nThis is then grouped by first_month and the amount of rows for each month is then counted, it is then ordered by first_month.\nThe dataframe is then printed for validation.","user":"anonymous","dateUpdated":"2025-12-14T22:36:56+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Ref. &lsquo;2.3.5.4 Bruker Kohorter Oppdelt på Første Måned med en Registrert Vurdering&rsquo; in raport.</h3>\n<h4>User cohorts segmented by first month with a registered rating.</h4>\n<p>in this section a new dataframe for cohorts_first is made by taking the dataframe user_first_last and adding a new column first_month, where the date value in first is converted to contain only year and month.<br />\nThis is then grouped by first_month and the amount of rows for each month is then counted, it is then ordered by first_month.<br />\nThe dataframe is then printed for validation.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098622_514248278","id":"paragraph_1765582714850_1807499540","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:36:56+0000","dateStarted":"2025-12-14T22:36:56+0000"},{"text":"// kode for Cohorts by first-rating month.\r\nval cohort_first = user_first_last\r\n    .withColumn(\"first_month\", date_format($\"first\", \"yyyy-MM\"))\r\n    .groupBy($\"first_month\").count().orderBy($\"first_month\")\r\ncohort_first.show(5)","user":"anonymous","dateUpdated":"2025-12-14T22:36:56+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"editorHide":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+-----------+-----+\n|first_month|count|\n+-----------+-----+\n|    1995-01|    2|\n|    1996-01|    6|\n|    1996-02|   20|\n|    1996-03|  226|\n|    1996-04| 1212|\n+-----------+-----+\nonly showing top 5 rows\n\n\u001b[1m\u001b[34mcohort_first\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [first_month: string, count: bigint]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=84"},{"jobUrl":"http://localhost:4040/jobs/job?id=85"},{"jobUrl":"http://localhost:4040/jobs/job?id=86"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098622_89924536","id":"paragraph_1758706284928_1081684833","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:37:58+0000","dateStarted":"2025-12-14T22:36:56+0000"},{"text":"%md\n### Ref. '2.3.5.5 Aktive Brukere +1, +2, +3 Måneder etter Første Vurdering' in report\n#### Active user with +1, +2 and +3 months since first registered rating.\n\nIn this section a new dataframe retention is made. This is done by taking the dataframe user_first_last and adding a new column for months_activ.\nIn this column we calculate the amount of months between the date values in the first and last columns, this in then casted to a int.\nThen all users with a month_activ value with less than 0 is removed, and it is then ordered by months_activ and counted.\nVariables for users with +1, +2 and +3 is then made by summarizing the values in months_activ based on the correct conditions.","user":"anonymous","dateUpdated":"2025-12-14T22:37:58+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Ref. &lsquo;2.3.5.5 Aktive Brukere +1, +2, +3 Måneder etter Første Vurdering&rsquo; in report</h3>\n<h4>Active user with +1, +2 and +3 months since first registered rating.</h4>\n<p>In this section a new dataframe retention is made. This is done by taking the dataframe user_first_last and adding a new column for months_activ.<br />\nIn this column we calculate the amount of months between the date values in the first and last columns, this in then casted to a int.<br />\nThen all users with a month_activ value with less than 0 is removed, and it is then ordered by months_activ and counted.<br />\nVariables for users with +1, +2 and +3 is then made by summarizing the values in months_activ based on the correct conditions.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098623_362338668","id":"paragraph_1765583224618_110636246","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:37:58+0000","dateStarted":"2025-12-14T22:37:58+0000"},{"text":"// kode for retention = share of users active in month +1,+2, +3.\r\nval retention = user_first_last\r\n    .withColumn(\"months_activ\", months_between($\"last\", $\"first\")\r\n    .cast(IntegerType))\r\n    .where($\"months_activ\" > 0)\r\n    .groupBy($\"months_activ\")    \r\n    .count()    \r\n    .orderBy(asc(\"months_activ\"))\r\n\r\nval mon1 = retention.where($\"months_activ\" > 0).agg(sum($\"count\")).first().getLong(0)\r\nval mon2 = retention.where($\"months_activ\" > 1).agg(sum($\"count\")).first().getLong(0)\r\nval mon3 = retention.where($\"months_activ\" > 2).agg(sum($\"count\")).first().getLong(0)\r\n\r\nprintln(s\"Users activ after +1 month: $mon1, +2 months: $mon3, +3months: $mon3\")","user":"anonymous","dateUpdated":"2025-12-14T22:37:58+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"editorHide":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Users activ after +1 month: 55266, +2 months: 44900, +3months: 44900\n\u001b[1m\u001b[34mretention\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [months_activ: int, count: bigint]\n\u001b[1m\u001b[34mmon1\u001b[0m: \u001b[1m\u001b[32mLong\u001b[0m = 55266\n\u001b[1m\u001b[34mmon2\u001b[0m: \u001b[1m\u001b[32mLong\u001b[0m = 49040\n\u001b[1m\u001b[34mmon3\u001b[0m: \u001b[1m\u001b[32mLong\u001b[0m = 44900\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=87"},{"jobUrl":"http://localhost:4040/jobs/job?id=88"},{"jobUrl":"http://localhost:4040/jobs/job?id=89"},{"jobUrl":"http://localhost:4040/jobs/job?id=90"},{"jobUrl":"http://localhost:4040/jobs/job?id=91"},{"jobUrl":"http://localhost:4040/jobs/job?id=92"},{"jobUrl":"http://localhost:4040/jobs/job?id=93"},{"jobUrl":"http://localhost:4040/jobs/job?id=94"},{"jobUrl":"http://localhost:4040/jobs/job?id=95"},{"jobUrl":"http://localhost:4040/jobs/job?id=96"},{"jobUrl":"http://localhost:4040/jobs/job?id=97"},{"jobUrl":"http://localhost:4040/jobs/job?id=98"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765751098623_636055","id":"paragraph_1758869201790_292377710","dateCreated":"2025-12-14T22:24:58+0000","status":"FINISHED","dateFinished":"2025-12-14T22:40:58+0000","dateStarted":"2025-12-14T22:37:58+0000"}],"name":"Movielens","id":"2MC6YX7Y4","defaultInterpreterGroup":"spark","version":"0.12.0","noteParams":{},"noteForms":{},"angularObjects":{},"config":{"isZeppelinNotebookCronEnable":false,"looknfeel":"default","personalizedMode":"false"},"info":{},"path":"/Movielens"}