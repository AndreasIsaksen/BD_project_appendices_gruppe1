1-01 00:00:00|2020-01-01 01:00:00|2020-01-01|00:00        |01:00        |Totalt i retning Fredrikstad sentrum|180          |100,0           |1                 |1                     |0                   |0                 |100,00                 |178   |2      |0          |2           |0            |0       |0            |0       |0     |\n+-------------------------+---------------+----------------+-------------------+-------------------+----------+-------------+-------------+------------------------------------+-------------+----------------+------------------+----------------------+--------------------+------------------+-----------------------+------+-------+-----------+------------+-------------+--------+-------------+--------+------+\nonly showing top 3 rows\n\n\u001b[1m\u001b[34mbil_raw_df\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [trafikkregistreringspunkt: string, navn: string ... 22 more fields]\n\u001b[1m\u001b[34mbil_raw\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [trafikkregistreringspunkt: string, navn: string ... 23 more fields]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=0"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762720776688_657134370","id":"paragraph_1762720776688_657134370","dateCreated":"2025-11-09T20:39:36+0000","dateStarted":"2025-11-11T12:56:28+0000","dateFinished":"2025-11-11T12:56:43+0000","status":"FINISHED","focus":false},{"text":"%spark\nval sykkel_raw_df = spark.read\n    .option(\"header\", true)\n    .option(\"recursiveFileLookup\", true)\n    .schema(trafikk_Schema)\n    .option(\"delimiter\", \";\")\n    .option(\"nullValue\", \"-\")\n    .option(\"timestampFormat\", \"yyyy-MM-dd'T'HH:mmXXX\")    \n    .csv(sykkel_base)\n\nval sykkel_raw = sykkel_raw_df.withColumn(\"klasse\", lit(1).cast(ByteType))\n\nsykkel_raw.show(3, truncate = false)","user":"anonymous","dateUpdated":"2025-11-11T12:56:53+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"editorHide":false},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+-------------------------+----------------------+----------------+-------------------+-------------------+----------+-------------+-------------+-----------------------+-------------+----------------+------------------+----------------------+--------------------+------------------+-----------------------+------+-------+-----------+------------+-------------+--------+-------------+--------+------+\n|trafikkregistreringspunkt|navn                  |vegreferanse    |fra                |til                |dato      |fra tidspunkt|til tidspunkt|felt                   |trafikkmengde|dekningsgrad (%)|antall timer total|antall timer inkludert|antall timer ugyldig|ikke gyldig lengde|lengdekvalitetsgrad (%)|< 5,6m|>= 5,6m|5,6m - 7,6m|7,6m - 12,5m|12,5m - 16,0m|>= 16,0m|16,0m - 24,0m|>= 24,0m|klasse|\n+-------------------------+----------------------+----------------+-------------------+-------------------+----------+-------------+-------------+-----------------------+-------------+----------------+------------------+----------------------+--------------------+------------------+-----------------------+------+-------+-----------+------------+-------------+--------+-------------+--------+------+\n|61523B971803             |St. Hansfjellet sykkel|KV26200 S1D60 m0|2016-06-15 12:00:00|2016-06-15 13:00:00|2016-06-15|12:00        |13:00        |1                      |NULL         |0,0             |1                 |1                     |1                   |NULL              |NULL                   |NULL  |NULL   |NULL       |NULL        |NULL         |NULL    |NULL         |NULL    |1     |\n|61523B971803             |St. Hansfjellet sykkel|KV26200 S1D60 m0|2016-06-15 12:00:00|2016-06-15 13:00:00|2016-06-15|12:00        |13:00        |2                      |NULL         |0,0             |1                 |1                     |1                   |NULL              |NULL                   |NULL  |NULL   |NULL       |NULL        |NULL         |NULL    |NULL         |NULL    |1     |\n|61523B971803             |St. Hansfjellet sykkel|KV26200 S1D60 m0|2016-06-15 12:00:00|2016-06-15 13:00:00|2016-06-15|12:00        |13:00        |Totalt i retning Dammyr|NULL         |0,0             |1                 |1                     |1                   |NULL              |NULL                   |NULL  |NULL   |NULL       |NULL        |NULL         |NULL    |NULL         |NULL    |1     |\n+-------------------------+----------------------+----------------+-------------------+-------------------+----------+-------------+-------------+-----------------------+-------------+----------------+------------------+----------------------+--------------------+------------------+-----------------------+------+-------+-----------+------------+-------------+--------+-------------+--------+------+\nonly showing top 3 rows\n\n\u001b[1m\u001b[34msykkel_raw_df\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [trafikkregistreringspunkt: string, navn: string ... 22 more fields]\n\u001b[1m\u001b[34msykkel_raw\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [trafikkregistreringspunkt: string, navn: string ... 23 more fields]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=1"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762721293152_509690199","id":"paragraph_1762721293152_509690199","dateCreated":"2025-11-09T20:48:13+0000","dateStarted":"2025-11-11T12:56:53+0000","dateFinished":"2025-11-11T12:56:58+0000","status":"FINISHED","focus":false},{"text":"%spark\nval weather_raw_df = spark.read\n    .option(\"header\", true)\n    .option(\"recursiveFileLookup\", true)\n    .schema(weather_Schema)\n    .option(\"delimiter\", \";\")\n    .option(\"nullValue\", \"-\")\n    .option(\"timestampFormat\", \"dd.MM.yyyy HH:mm\")\n    .csv(weather_base)\n\nweather_raw_df.show(3, truncate = false)","user":"anonymous","dateUpdated":"2025-11-11T12:57:08+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"editorHide":false},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+---------------+-------+--------------------+------------+--------------+------------------------+\n|navn           |stasjon|tid(norsk normaltid)|nedbør (1 t)|lufttemperatur|høyeste middelvind (1 t)|\n+---------------+-------+--------------------+------------+--------------+------------------------+\n|Strømtangen Fyr|SN17000|2005-01-01 01:00:00 |0           |-0,1          |NULL                    |\n|Strømtangen Fyr|SN17000|2005-01-01 02:00:00 |0           |-1,3          |NULL                    |\n|Strømtangen Fyr|SN17000|2005-01-01 03:00:00 |0           |-2,2          |NULL                    |\n+---------------+-------+--------------------+------------+--------------+------------------------+\nonly showing top 3 rows\n\n\u001b[1m\u001b[34mweather_raw_df\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [navn: string, stasjon: string ... 4 more fields]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=2"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762721348676_203792973","id":"paragraph_1762721348676_203792973","dateCreated":"2025-11-09T20:49:08+0000","dateStarted":"2025-11-11T12:57:08+0000","dateFinished":"2025-11-11T12:57:13+0000","status":"FINISHED","focus":false},{"text":"%spark\nval trafikk_raw_df = bil_raw.union(sykkel_raw)\ntrafikk_raw_df.show(3, truncate = false)","user":"anonymous","dateUpdated":"2025-11-11T12:57:15+0000","progress":0,"config":{"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"fontSize":9,"editorHide":false,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+-------------------------+---------------+----------------+-------------------+-------------------+----------+-------------+-------------+------------------------------------+-------------+----------------+------------------+----------------------+--------------------+------------------+-----------------------+------+-------+-----------+------------+-------------+--------+-------------+--------+------+\n|trafikkregistreringspunkt|navn           |vegreferanse    |fra                |til                |dato      |fra tidspunkt|til tidspunkt|felt                                |trafikkmengde|dekningsgrad (%)|antall timer total|antall timer inkludert|antall timer ugyldig|ikke gyldig lengde|lengdekvalitetsgrad (%)|< 5,6m|>= 5,6m|5,6m - 7,6m|7,6m - 12,5m|12,5m - 16,0m|>= 16,0m|16,0m - 24,0m|>= 24,0m|klasse|\n+-------------------------+---------------+----------------+-------------------+-------------------+----------+-------------+-------------+------------------------------------+-------------+----------------+------------------+----------------------+--------------------+------------------+-----------------------+------+-------+-----------+------------+-------------+--------+-------------+--------+------+\n|61523V971803             |St. Hansfjellet|RV110 S3D1 m3841|2020-01-01 00:00:00|2020-01-01 01:00:00|2020-01-0