4:44+0000","dateFinished":"2025-12-14T02:14:44+0000","status":"FINISHED"},{"text":"%md\n#### Description\nThis table has the same structure and purpose as the table in Hypothesis 3, but it is designed to store car traffic data.\nThe purpose of this table is to store car traffic data together with corresponding air temperature in order to analyse the correlation between these variables.\nTo answer the hypothesis and analyse the correlation, we need to extract hourly data across entire days, enabling comparisons between the hypothesis' reference period and other time intervals.\nThe content of this table is partitioned by **navn** to efficiently retrieve data for specific traffic monitoring points.\nEach partition is then ordered by **dato** to support time-based queries within each location without requiring additional filtering in the queries.","user":"anonymous","dateUpdated":"2025-12-14T02:14:45+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h4>Description</h4>\n<p>This table has the same structure and purpose as the table in Hypothesis 3, but it is designed to store car traffic data.<br />\nThe purpose of this table is to store car traffic data together with corresponding air temperature in order to analyse the correlation between these variables.<br />\nTo answer the hypothesis and analyse the correlation, we need to extract hourly data across entire days, enabling comparisons between the hypothesis&rsquo; reference period and other time intervals.<br />\nThe content of this table is partitioned by <strong>navn</strong> to efficiently retrieve data for specific traffic monitoring points.<br />\nEach partition is then ordered by <strong>dato</strong> to support time-based queries within each location without requiring additional filtering in the queries.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765678395697_1328514328","id":"paragraph_1763975246777_2147108239","dateCreated":"2025-12-14T02:13:15+0000","dateStarted":"2025-12-14T02:14:45+0000","dateFinished":"2025-12-14T02:14:45+0000","status":"FINISHED"},{"text":"%cassandra\nUSE capstone_ks;\n\nCREATE TABLE IF NOT EXISTS bil_temp_corr(\n    navn TEXT,\n    dato DATE,\n    fra TINYINT,\n    til TINYINT,\n    lufttemperatur FLOAT,\n    trafikkmengde SMALLINT,\nPRIMARY KEY (navn, dato, fra)\n)WITH CLUSTERING ORDER BY (dato ASC);","user":"anonymous","dateUpdated":"2025-12-14T02:14:45+0000","progress":0,"config":{"editorSetting":{"editOnDblClick":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"\n\n\n\n\n\n<div class=\"container\">\n<div class=\"row\">\n  <h5>No Result &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n    <a role=\"button\" data-toggle=\"collapse\" data-target=\"#f6570a9f-6ce0-40a6-a522-e3538f40922e\" aria-expanded=\"false\">\n      <span class=\"text-info\"><strong>Last query execution info</strong></span>\n    </a>\n  </h5>\n</div>\n<div class=\"panel panel-default\">\n  <div id=\"f6570a9f-6ce0-40a6-a522-e3538f40922e\" class=\"panel-collapse collapse\" role=\"tabpanel\">\n    <div class=\"panel-body\">\n      <div class=\"row\">\n        <div class=\"col-md-3\"></div>\n        <div class=\"col-md-6 col-offset-md-3 table-responsive table-bordered\">\n          <table class=\"table\">\n            <thead>\n              <tr>\n                <th>Information</th>\n                <th style=\"text-align:left\">Value</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <td>Statement</td>\n                <td style=\"text-align:left\">CREATE TABLE IF NOT EXISTS bil_temp_corr(\n    navn TEXT,\n    dato DATE,\n    fra TINYINT,\n    til TINYINT,\n    lufttemperatur FLOAT,\n    trafikkmengde SMALLINT,\nPRIMARY KEY (navn, dato, fra)\n)WITH CLUSTERING ORDER BY (dato ASC);</td>\n              </tr>\n              <tr>\n                <td>Tried Hosts</td>\n                <td style=\"text-align:left\">cassandra-seed:9042</td>\n              </tr>\n              <tr>\n                <td>Queried Hosts</td>\n                <td style=\"text-align:left\">cassandra-seed:9042</td>\n              </tr>\n              <tr>\n                <td>Schema in Agreement</td>\n                <td style=\"text-align:left\">true</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765678395697_1478823504","id":"paragraph_1762981147265_2070065570","dateCreated":"2025-12-14T02:13:15+0000","dateStarted":"2025-12-14T02:14:45+0000","dateFinished":"2025-12-14T02:14:45+0000","status":"FINISHED"},{"text":"%md\n### Hypothesis 5\nData kan benyttes til å forutsi om det er blitt utført veiarbeid eller vedlikehold på et gitt trafikk registreringspunkt basert på uregelmessigheter i trafikkmålinger","user":"anonymous","dateUpdated":"2025-12-14T02:14:45+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"editOnDblClick":true,"language":"markdown","completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Hypothesis 5</h3>\n<p>Data kan benyttes til å forutsi om det er blitt utført veiarbeid eller vedlikehold på et gitt trafikk registreringspunkt basert på uregelmessigheter i trafikkmålinger</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765678395698_1422004411","id":"paragraph_1762981274303_1118214640","dateCreated":"2025-12-14T02:13:15+0000","dateStarted":"2025-12-14T02:14:45+0000","dateFinished":"2025-12-14T02:14:45+0000","status":"FINISHED"},{"text":"%md\n#### Description\nThe purpose of this table is to store all records where ( \\text{dekningsgrad (%)} = 0 ) in order to analyse potential irregularities that may indicate roadwork or maintenance activity.\nHere, we are only interested in the location, date, and time of the registration.\nThe content of this table is partitioned by **navn** to efficiently retrieve data for specific traffic monitoring points.\nEach partition is then ordered by **year**, **dato** and **fra** (start time) to support time-based queries within each location without requiring additional filtering in the queries.","user":"anonymous","dateUpdated":"2025-12-14T19:09:30+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h4>Description</h4>\n<p>The purpose of this table is to store all records where ( \\text{dekningsgrad (%)} = 0 ) in order to analyse potential irregularities that may indicate roadwork or maintenance activity.<br />\nHere, we are only interested in the location, date, and time of the registration.<br />\nThe content of this table is partitioned by <strong>navn</strong> to efficiently retrieve data for specific traffic monitoring points.<br />\nEach partition is then ordered by <strong>year</strong>, <strong>dato</strong> and <strong>fra</strong> (start time) to support time-based queries within each location without requiring additional filtering in the queries.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1765678395698_1081871058","id":"paragraph_1763975251215_129320445