{"paragraphs":[{"text":"%spark\r\nimport spark.implicits._\r\nimport org.apache.spark.sql.types._\r\nimport org.apache.spark.sql.expressions._\r\nimport org.apache.spark.sql.functions._","user":"anonymous","dateUpdated":"2025-11-02T22:18:53+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"import spark.implicits._\nimport org.apache.spark.sql.types._\nimport org.apache.spark.sql.expressions._\nimport org.apache.spark.sql.functions._\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762006959756_1730097333","id":"paragraph_1762006959756_1730097333","dateCreated":"2025-11-01T14:22:39+0000","dateStarted":"2025-11-02T22:18:53+0000","dateFinished":"2025-11-02T22:18:56+0000","status":"FINISHED","focus":false},{"text":"%spark\r\n// Import TLC data:\r\nval refPath = \"/sparkio/TLC/trips/2025/yellow_tripdata_2025-01.parquet\"\r\nval refSchema = spark.read.parquet(refPath).schema\r\nval base = (\"/sparkio/TLC/trips/2025/yellow*.parquet\")\r\nval tlc_df_raw = spark.read\r\n\t.option(\"recursiveFileLookup\", true)\r\n\t.schema(refSchema)\r\n\t.parquet(base)\r\n\r\n// Import of MapZone data:\r\nval zoneBase = (\"/sparkio/TLC/mapZones/taxi_zone_lookup.csv\")\r\nval zoneSchema = StructType(Array(\r\n    StructField(\"LocationID\", IntegerType, true),\r\n    StructField(\"Borough\", StringType, true),\r\n    StructField(\"Zone\", StringType, true),\r\n    StructField(\"service_zone\", StringType, true)\r\n))\r\nval dfZone = spark.read\r\n\t.option(\"header\", \"true\")\r\n    .schema(zoneSchema)\r\n    .csv(zoneBase)\r\n\r\n// TLC parquet dataTypes correction:\r\nval typeFix = tlc_df_raw\r\n    .withColumn(\"VendorID\", col(\"VendorID\").cast(\"byte\"))\r\n    .withColumn(\"tpep_pickup_datetime\", col(\"tpep_pickup_datetime\").cast(\"timestamp\"))\r\n    .withColumn(\"tpep_dropoff_datetime\", col(\"tpep_dropoff_datetime\").cast(\"timestamp\"))\r\n    .withColumn(\"passenger_count\", col(\"passenger_count\").cast(\"byte\"))\r\n    .withColumn(\"RatecodeID\", col(\"RatecodeID\").cast(\"byte\"))\r\n    .withColumn(\"store_and_fwd_flag\", (col(\"store_and_fwd_flag\") === lit(\"Y\")).cast(\"boolean\"))\r\n    .withColumn(\"payment_type\", col(\"payment_type\").cast(\"byte\"))\r\n\r\n// Adding time columns to TLC df.\r\nval dfWithSpeed = typeFix\r\n    .withColumn(\"pickup_day\", col(\"tpep_pickup_datetime\"))\r\n    .withColumn(\"dropoff_day\", col(\"tpep_dropoff_datetime\"))\r\n    .withColumn(\"pickup_sec\",  col(\"tpep_pickup_datetime\").cast(\"long\"))\r\n    .withColumn(\"dropoff_sec\", col(\"tpep_dropoff_datetime\").cast(\"long\"))\r\n    // duration in hours.\r\n    .withColumn(\"duration_hours\",\r\n      (col(\"dropoff_sec\") - col(\"pickup_sec\")) / 3600.0\r\n    )\r\n    // speed = miles / hours.\r\n    .withColumn(\r\n      \"Speed_miles_pr_hour\",\r\n      when(col(\"duration_hours\") > 0,\r\n           col(\"trip_distance\") / col(\"duration_hours\")\r\n      ).otherwise(lit(null).cast(\"double\"))\r\n    )\r\n    // Travel duration in minutes.\r\n    .withColumn(\r\n        \"trip_duration_min\",\r\n        when(not(col(\"duration_hours\").isNull),\r\n            col(\"duration_hours\") * 60\r\n        ).otherwise(lit(null).cast(\"double\"))\r\n    )\r\n    .drop(\"pickup_sec\",\"dropoff_sec\",\"duration_hours\")\r\n    .withColumn(\"Speed_miles_pr_hour\", round(col(\"Speed_miles_pr_hour\"), 2))\r\n    .withColumn(\"trip_duration_min\", round(col(\"trip_duration_min\"), 2))\r\n    .withColumn(\"hour_of_day\", date_format(col(\"pickup_day\"), \"k\"))\r\n    .withColumn(\"pickup_day\", dayofweek(col(\"pickup_day\")))\r\n    .withColumn(\"dropoff_day\", dayofweek(col(\"dropoff_day\")))\r\n\r\n// Remove redundant rows:\r\nval dfWithSpeedRmHighSpeedAndNull = dfWithSpeed.filter(col(\"Speed_miles_pr_hour\") <= 80)\r\nval PositiveFare = dfWithSpeedRmHighSpeedAndNull.filter(col(\"total_amount\") > 0)\r\nval passengerMoreThanZero = PositiveFare.filter(col(\"passenger_count\") > 0)\r\n\r\n// Join operation on TLC and Zones data:\r\nval tlc_final =\r\n  passengerMoreThanZero.alias(\"m\")\r\n    .join(dfZone.alias(\"zpu\"),\r\n        col(\"m.PULocationID\") === col(\"zpu.LocationID\"),\r\n        \"left\")\r\n    .join(dfZone.alias(\"zdo\"),\r\n        col(\"m.DOLocationID\") === col (\"zdo.LocationID\"),\r\n        \"left\")\r\n    .select(col(\"m.*\"),\r\n        col(\"zpu.Zone\").as(\"pickup_location_name\"),\r\n        col(\"zpu.Borough\").as(\"PU_Borough\"),\r\n        col(\"zdo.Zone\").as(\"dropoff_location_name\"),\r\n        col(\"zdo.Borough\").as(\"DO_Borough\"))\r\n    .withColumnRenamed(\"tpep_pickup_datetime\", \"pickup_date\")\r\n    .withColumnRenamed(\"tpep_dropoff_datetime\", \"dropoff_date\")\r\n\r\n// Simple validation on final result:\r\nprint(\"Number under should be 20622905.\\n\")\r\nprint(tlc_final.count())\r\nprint(\"\\nSmall controll on datatypes:\\n\")\r\nprint(tlc_final.printSchema())\r\nprint(\"\\n Overview of the main TLC df:\\n\")\r\ntlc_final.show(3, truncate = false)","user":"anonymous","dateUpdated":"2025-11-02T22:18:31+0000","progress":100,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Number under should be 20622905.\n20622905\nSmall controll on datatypes:\nroot\n |-- VendorID: byte (nullable = true)\n |-- pickup_date: timestamp (nullable = true)\n |-- dropoff_date: timestamp (nullable = true)\n |-- passenger_count: byte (nullable = true)\n |-- trip_distance: double (nullable = true)\n |-- RatecodeID: byte (nullable = true)\n |-- store_and_fwd_flag: boolean (nullable = true)\n |-- PULocationID: integer (nullable = true)\n |-- DOLocationID: integer (nullable = true)\n |-- payment_type: byte (nullable = true)\n |-- fare_amount: double (nullable = true)\n |-- extra: double (nullable = true)\n |-- mta_tax: double (nullable = true)\n |-- tip_amount: double (nullable = true)\n |-- tolls_amount: double (nullable = true)\n |-- improvement_surcharge: double (nullable = true)\n |-- total_amount: double (nullable = true)\n |-- congestion_surcharge: double (nullable = true)\n |-- Airport_fee: double (nullable = true)\n |-- cbd_congestion_fee: double (nullable = true)\n |-- pickup_day: integer (nullable = true)\n |-- dropoff_day: integer (nullable = true)\n |-- Speed_miles_pr_hour: double (nullable = true)\n |-- trip_duration_min: double (nullable = true)\n |-- hour_of_day: string (nullable = true)\n |-- pickup_location_name: string (nullable = true)\n |-- PU_Borough: string (nullable = true)\n |-- dropoff_location_name: string (nullable = true)\n |-- DO_Borough: string (nullable = true)\n\n()\n Overview of the main TLC df:\n+--------+-------------------+-------------------+---------------+-------------+----------+------------------+------------+------------+------------+-----------+-----+-------+----------+------------+---------------------+------------+--------------------+-----------+------------------+----------+-----------+-------------------+-----------------+-----------+--------------------+----------+---------------------+----------+\n|VendorID|pickup_date        |dropoff_date       |passenger_count|trip_distance|RatecodeID|store_and_fwd_flag|PULocationID|DOLocationID|payment_type|fare_amount|extra|mta_tax|tip_amount|tolls_amount|improvement_surcharge|total_amount|congestion_surcharge|Airport_fee|cbd_congestion_fee|pickup_day|dropoff_day|Speed_miles_pr_hour|trip_duration_min|hour_of_day|pickup_location_name|PU_Borough|dropoff_location_name|DO_Borough|\n+--------+-------------------+-------------------+---------------+-------------+----------+------------------+------------+------------+------------+-----------+-----+-------+----------+------------+---------------------+------------+--------------------+-----------+------------------+----------+-----------+-------------------+-----------------+-----------+--------------------+----------+---------------------+----------+\n|1       |2025-05-01 00:07:06|2025-05-01 00:24:15|1              |3.7          |1         |false             |140         |202         |1           |18.4       |4.25 |0.5    |4.85      |0.0         |1.0                  |29.0        |2.5                 |0.0        |0.75              |5         |5          |12.94              |17.15            |24         |Lenox Hill East     |Manhattan |Roosevelt Island     |Manhattan |\n|2       |2025-05-01 00:07:44|2025-05-01 00:14:27|1              |1.03         |1         |false             |234         |161         |1           |8.6        |1.0  |0.5    |4.3       |0.0         |1.0                  |18.65       |2.5                 |0.0        |0.75              |5         |5          |9.2                |6.72             |24         |Union Sq            |Manhattan |Midtown Center       |Manhattan |\n|2       |2025-05-01 00:15:56|2025-05-01 00:23:53|1              |1.57         |1         |false             |161         |234         |2           |10.0       |1.0  |0.5    |0.0       |0.0         |1.0                  |15.75       |2.5                 |0.0        |0.75              |5         |5          |11.85              |7.95             |24         |Midtown Center      |Manhattan |Union Sq             |Manhattan |\n+--------+-------------------+-------------------+---------------+-------------+----------+------------------+------------+------------+------------+-----------+-----+-------+----------+------------+---------------------+------------+--------------------+-----------+------------------+----------+-----------+-------------------+-----------------+-----------+--------------------+----------+---------------------+----------+\nonly showing top 3 rows\n\n\u001b[1m\u001b[34mrefPath\u001b[0m: \u001b[1m\u001b[32mString\u001b[0m = /sparkio/TLC/trips/2025/yellow_tripdata_2025-01.parquet\n\u001b[1m\u001b[34mrefSchema\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.types.StructType\u001b[0m = StructType(StructField(VendorID,IntegerType,true),StructField(tpep_pickup_datetime,TimestampNTZType,true),StructField(tpep_dropoff_datetime,TimestampNTZType,true),StructField(passenger_count,LongType,true),StructField(trip_distance,DoubleType,true),StructField(RatecodeID,LongType,true),StructField(store_and_fwd_flag,StringType,true),StructField(PULocationID,IntegerType,true),StructField(DOLocationID,IntegerType,true),StructField(payment_type,LongType,true),StructField(fare_amount,DoubleType,true),StructField(extra,DoubleType,true),StructField(mta_tax,DoubleType,true),StructField(tip_amount,DoubleType,true),Struct...\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=0"},{"jobUrl":"http://localhost:4040/jobs/job?id=1"},{"jobUrl":"http://localhost:4040/jobs/job?id=2"},{"jobUrl":"http://localhost:4040/jobs/job?id=3"},{"jobUrl":"http://localhost:4040/jobs/job?id=4"},{"jobUrl":"http://localhost:4040/jobs/job?id=5"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762008654184_1104084380","id":"paragraph_1762008654184_1104084380","dateCreated":"2025-11-01T14:50:54+0000","dateStarted":"2025-11-02T18:20:16+0000","dateFinished":"2025-11-02T18:21:16+0000","status":"FINISHED"},{"text":"%md\r\n### Ref. ‘2.4.1.1 Target queries’ in report.\r\n#### Trips by pickup date (e.g., all trips starting in zone X on day Y)\r\nThe cell below takes out the relevant columns from the `tlc_final` dataframe and aggregates it to fit the table structure for the Cassandra table `trips_by_day_zone`.  \r\nAfter the dataframe is complete, it's directly being exported to the corresponding table.","user":"anonymous","dateUpdated":"2025-11-02T03:23:55+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"editorHide":true,"tableHide":false},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Ref. ‘2.4.1.1 Target queries’ in report.</h3>\n<h4>Trips by pickup date (e.g., all trips starting in zone X on day Y)</h4>\n<p>The cell below takes out the relevant columns from the <code>tlc_final</code> dataframe and aggregates it to fit the table structure for the Cassandra table <code>trips_by_day_zone</code>.<br />\nAfter the dataframe is complete, it&rsquo;s directly being exported to the corresponding table.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762012177949_2109964072","id":"paragraph_1762012177949_2109964072","dateCreated":"2025-11-01T15:49:37+0000","dateStarted":"2025-11-02T03:23:55+0000","dateFinished":"2025-11-02T03:24:00+0000","status":"FINISHED"},{"text":"%spark\r\nval trips_by_day_zone_df = tlc_final\r\n    .select(\r\n        col(\"pickup_date\"),\r\n        col(\"pickup_location_name\").as(\"pickup_zone\")\r\n    )\r\n    .withColumn(\"pickup_date\", to_date(col(\"pickup_date\"), \"yyyy-MM-dd\"))\r\n    .groupBy(\"pickup_date\", \"pickup_zone\")\r\n    .agg(count(\"*\").as(\"number_of_trips\"))\r\n    .orderBy(\"pickup_date\", \"pickup_zone\")\r\n\r\ntrips_by_day_zone_df.write\r\n    .format(\"org.apache.spark.sql.cassandra\")\r\n    .options(Map(\r\n        \"table\" -> \"trips_by_day_zone\",\r\n        \"keyspace\" -> \"tlc_ks\"\r\n    ))\r\n    .mode(\"append\")\r\n    .save()","user":"anonymous","dateUpdated":"2025-11-02T22:18:34+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mtrips_by_day_zone_df\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [pickup_date: date, pickup_zone: string ... 1 more field]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=18"},{"jobUrl":"http://localhost:4040/jobs/job?id=19"},{"jobUrl":"http://localhost:4040/jobs/job?id=20"},{"jobUrl":"http://localhost:4040/jobs/job?id=21"},{"jobUrl":"http://localhost:4040/jobs/job?id=22"},{"jobUrl":"http://localhost:4040/jobs/job?id=23"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762034070759_1546874332","id":"paragraph_1762034070759_1546874332","dateCreated":"2025-11-01T21:54:30+0000","dateStarted":"2025-11-02T20:17:20+0000","dateFinished":"2025-11-02T20:18:03+0000","status":"FINISHED"},{"text":"%md\r\n#### Top drop-off zones for a pickup zone (with counts)\r\nThe cell below takes out the relevant columns from the `tlc_final` dataframe and aggregates it to fit the table structure for the Cassandra table `top_dropoff_zones_by_pickup_zone`.  \r\nAfter the dataframe is complete, it's directly being exported to the corresponding table.","user":"anonymous","dateUpdated":"2025-11-02T14:38:26+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h4>Top drop-off zones for a pickup zone (with counts)</h4>\n<p>The cell below takes out the relevant columns from the <code>tlc_final</code> dataframe and aggregates it to fit the table structure for the Cassandra table <code>top_dropoff_zones_by_pickup_zone</code>.<br />\nAfter the dataframe is complete, it&rsquo;s directly being exported to the corresponding table.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762034851023_1267654086","id":"paragraph_1762034851023_1267654086","dateCreated":"2025-11-01T22:07:31+0000","dateStarted":"2025-11-02T14:38:26+0000","dateFinished":"2025-11-02T14:38:26+0000","status":"FINISHED"},{"text":"%spark\nval filter_dropof = tlc_final\n    .select(\n        col(\"pickup_location_name\").as(\"pickup_zone\"),\n        col(\"dropoff_location_name\").as(\"dropoff_zone\")\n    )\n    .groupBy(\"pickup_zone\", \"dropoff_zone\")\n    .agg(\n        count(\"*\").as(\"trips\")\n    )\n    .withColumn(\n        \"rank\",\n        rank().over(Window.partitionBy(\"pickup_zone\").orderBy(desc(\"trips\")))\n    )\n    .where(col(\"rank\") === 1)\n    .drop(\"rank\")\n    .orderBy(desc(\"trips\"))\n\n\nfilter_dropof.write\n    .format(\"org.apache.spark.sql.cassandra\")\n    .options(Map(\n        \"table\" -> \"top_dropoff_zones_by_pickup_zone\",\n        \"keyspace\" -> \"tlc_ks\"\n    ))\n    .mode(\"append\")\n    .save()","user":"anonymous","dateUpdated":"2025-11-02T22:18:36+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=36"},{"jobUrl":"http://localhost:4040/jobs/job?id=37"},{"jobUrl":"http://localhost:4040/jobs/job?id=38"},{"jobUrl":"http://localhost:4040/jobs/job?id=39"},{"jobUrl":"http://localhost:4040/jobs/job?id=40"},{"jobUrl":"http://localhost:4040/jobs/job?id=41"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762042608430_1908574658","id":"paragraph_1762042608430_1908574658","dateCreated":"2025-11-02T00:16:48+0000","dateStarted":"2025-11-02T03:32:30+0000","dateFinished":"2025-11-02T03:32:30+0000","status":"FINISHED"},{"text":"%md\r\n#### Daily revenue per borough\r\nThe cell below takes out the relevant columns from the `tlc_final` dataframe and aggregates it to fit the table structure for the Cassandra table `daily_revenue_by_borough`.  \r\nAfter the dataframe is complete, it's directly being exported to the corresponding table.","user":"anonymous","dateUpdated":"2025-11-02T16:34:16+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"editorHide":true,"tableHide":false},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h4>Daily revenue per borough</h4>\n<p>The cell below takes out the relevant columns from the <code>tlc_final</code> dataframe and aggregates it to fit the table structure for the Cassandra table <code>daily_revenue_by_borough</code>.<br />\nAfter the dataframe is complete, it&rsquo;s directly being exported to the corresponding table.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762044827160_249678275","id":"paragraph_1762044827160_249678275","dateCreated":"2025-11-02T00:53:47+0000","dateStarted":"2025-11-02T16:34:16+0000","dateFinished":"2025-11-02T16:34:17+0000","status":"FINISHED"},{"text":"%spark\nval daily_revenue_by_borough_df = tlc_final\n    .select(\n        col(\"PU_Borough\").as(\"borough\"),\n        col(\"pickup_date\").as(\"day\"),\n        col(\"total_amount\")\n    )\n    .withColumn(\"day\", to_date(col(\"day\"), \"yyyy-MM-dd\"))\n    .groupBy(\"day\", \"borough\")\n    .agg(sum(\"total_amount\").cast(\"float\").as(\"revenue\"))\n    .orderBy(\"day\")\n\ndaily_revenue_by_borough_df.write\n    .format(\"org.apache.spark.sql.cassandra\")\n    .options(Map(\n        \"table\" -> \"daily_revenue_by_borough\",\n        \"keyspace\" -> \"tlc_ks\"\n    ))\n    .mode(\"append\")\n    .save()","user":"anonymous","dateUpdated":"2025-11-02T22:18:38+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mdaily_revenue_by_borough_df\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [day: date, borough: string ... 1 more field]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=22"},{"jobUrl":"http://localhost:4040/jobs/job?id=23"},{"jobUrl":"http://localhost:4040/jobs/job?id=24"},{"jobUrl":"http://localhost:4040/jobs/job?id=25"},{"jobUrl":"http://localhost:4040/jobs/job?id=26"},{"jobUrl":"http://localhost:4040/jobs/job?id=27"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762094300931_2004626369","id":"paragraph_1762094300931_2004626369","dateCreated":"2025-11-02T14:38:20+0000","dateStarted":"2025-11-02T14:51:47+0000","dateFinished":"2025-11-02T14:52:12+0000","status":"FINISHED"},{"text":"%md\r\n### Ref. ‘2.4.1.2 Activity’ in report.\r\n#### Clustering columns for sorting by drop-off or fare\r\nThe cell below takes out the relevant columns from the `tlc_final` dataframe and aggregates it to fit the table structure for the Cassandra table `trips_by_day_zone_dropoff` and `trips_by_day_zone_fare`.  \r\nAfter the dataframe is complete, it's directly being exported to the corresponding table.","user":"anonymous","dateUpdated":"2025-11-02T17:17:36+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Ref. ‘2.4.1.2 Activity’ in report.</h3>\n<h4>Clustering columns for sorting by drop-off or fare</h4>\n<p>The cell below takes out the relevant columns from the <code>tlc_final</code> dataframe and aggregates it to fit the table structure for the Cassandra table <code>trips_by_day_zone_dropoff</code> and <code>trips_by_day_zone_fare</code>.<br />\nAfter the dataframe is complete, it&rsquo;s directly being exported to the corresponding table.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762094775201_1579029624","id":"paragraph_1762094775201_1579029624","dateCreated":"2025-11-02T14:46:15+0000","dateStarted":"2025-11-02T17:17:36+0000","dateFinished":"2025-11-02T17:17:36+0000","status":"FINISHED"},{"text":"%spark\r\nval dropoff_and_fare_df = tlc_final\r\n    .select(\r\n        col(\"pickup_date\"),\r\n        col(\"pickup_location_name\").as(\"pickup_zone\"),\r\n        col(\"dropoff_location_name\").as(\"dropoff_zone\"),\r\n        col(\"total_amount\").as(\"fare_amount\")\r\n    )\r\n    .withColumn(\"pickup_date\", to_date(col(\"pickup_date\"), \"yyyy-MM-dd\"))\r\n    .withColumn(\"fare_amount\", col(\"fare_amount\").cast(\"float\"))\r\n\r\nval dropoff_df = dropoff_and_fare_df.drop(col(\"fare_amount\"))\r\n\r\nval fare_df = dropoff_and_fare_df.drop(col(\"dropoff_zone\"))\r\n\r\ndropoff_df.write\r\n    .format(\"org.apache.spark.sql.cassandra\")\r\n    .options(Map(\r\n        \"table\" -> \"trips_by_day_zone_dropoff\",\r\n        \"keyspace\" -> \"tlc_ks\"\r\n    ))\r\n    .mode(\"append\")\r\n    .save()\r\n\r\nfare_df.write\r\n    .format(\"org.apache.spark.sql.cassandra\")\r\n    .options(Map(\r\n        \"table\" -> \"trips_by_day_zone_fare\",\r\n        \"keyspace\" -> \"tlc_ks\"\r\n    ))\r\n    .mode(\"append\")\r\n    .save()","user":"anonymous","dateUpdated":"2025-11-02T22:18:41+0000","progress":100,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mdropoff_and_fare_df\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [pickup_date: date, pickup_zone: string ... 2 more fields]\n\u001b[1m\u001b[34mdropoff_df\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [pickup_date: date, pickup_zone: string ... 1 more field]\n\u001b[1m\u001b[34mfare_df\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [pickup_date: date, pickup_zone: string ... 1 more field]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=6"},{"jobUrl":"http://localhost:4040/jobs/job?id=7"},{"jobUrl":"http://localhost:4040/jobs/job?id=8"},{"jobUrl":"http://localhost:4040/jobs/job?id=9"},{"jobUrl":"http://localhost:4040/jobs/job?id=10"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762094865457_497858288","id":"paragraph_1762094865457_497858288","dateCreated":"2025-11-02T14:47:45+0000","dateStarted":"2025-11-02T18:29:58+0000","dateFinished":"2025-11-02T19:00:03+0000","status":"FINISHED"},{"text":"%spark\r\ndropoff_df.write\r\n    .format(\"org.apache.spark.sql.cassandra\")\r\n    .options(Map(\r\n        \"table\" -> \"trips_by_day_zone_dropoff\",\r\n        \"keyspace\" -> \"tlc_ks\"\r\n    ))\r\n    .mode(\"append\")\r\n    .save()\r\n\r\nfare_df.write\r\n    .format(\"org.apache.spark.sql.cassandra\")\r\n    .options(Map(\r\n        \"table\" -> \"trips_by_day_zone_fare\",\r\n        \"keyspace\" -> \"tlc_ks\"\r\n    ))\r\n    .mode(\"append\")\r\n    .save()","user":"anonymous","dateUpdated":"2025-11-02T22:18:52+0000","progress":85,"config":{"tableHide":false,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"},"colWidth":12,"fontSize":9,"editorHide":false,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://localhost:4040/jobs/job?id=13"},{"jobUrl":"http://localhost:4040/jobs/job?id=14"},{"jobUrl":"http://localhost:4040/jobs/job?id=15"},{"jobUrl":"http://localhost:4040/jobs/job?id=16"},{"jobUrl":"http://localhost:4040/jobs/job?id=17"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762101502041_962002948","id":"paragraph_1762101502041_962002948","dateCreated":"2025-11-02T16:38:22+0000","dateStarted":"2025-11-02T19:38:40+0000","dateFinished":"2025-11-02T19:51:20+0000","status":"FINISHED"},{"text":"","user":"anonymous","dateUpdated":"2025-11-02T18:19:08+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762106977637_15331095","id":"paragraph_1762106977637_15331095","dateCreated":"2025-11-02T18:09:37+0000","status":"READY"},{"text":"%md\n#### Create trips_by_day_zone\nThe cell below takes out the relevant columns from the `tlc_final` dataframe and aggregates it to fit the table structure for the Cassandra table `trips_by_day_zone`.\nAfter the dataframe is complete