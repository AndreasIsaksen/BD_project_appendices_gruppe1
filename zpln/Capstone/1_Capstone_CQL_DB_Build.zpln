MALLINT,\nPRIMARY KEY (navn, dato, klasse, ukedag)\n)WITH CLUSTERING ORDER BY (dato ASC);</td>\n              </tr>\n              <tr>\n                <td>Tried Hosts</td>\n                <td style=\"text-align:left\">cassandra-seed:9042</td>\n              </tr>\n              <tr>\n                <td>Queried Hosts</td>\n                <td style=\"text-align:left\">cassandra-seed:9042</td>\n              </tr>\n              <tr>\n                <td>Schema in Agreement</td>\n                <td style=\"text-align:left\">true</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n"}]}},{"text":"%md\n","user":"anonymous","dateUpdated":"2025-11-12T21:01:42+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"editOnDblClick":true,"language":"markdown","completionSupport":false}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762981297364_1469161744","id":"paragraph_1762981297364_1469161744","dateCreated":"2025-11-12T21:01:37+0000","status":"READY","focus":false,"results":{}},{"text":"%cassandra\nUSE capstone_ks;\n\nCREATE TABLE IF NOT EXISTS rushtid_2(\n\nPRIMARY KEY ()\n)WITH CLUSTERING ORDER BY ();","user":"anonymous","dateUpdated":"2025-11-12T20:58:34+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"editOnDblClick":false}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762980867824_1050673964","id":"paragraph_1762980867824_1050673964","dateCreated":"2025-11-12T20:54:27+0000","status":"READY","focus":false,"results":{}},{"text":"%md\n","user":"anonymous","dateUpdated":"2025-11-12T21:01:37+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"editOnDblClick":true,"language":"markdown","completionSupport":