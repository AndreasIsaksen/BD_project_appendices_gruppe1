{"paragraphs":[{"text":"%spark\r\n// Package import\r\nimport spark.implicits._\r\nimport org.apache.spark.sql.types._\r\nimport org.apache.spark.sql.expressions._\r\nimport org.apache.spark.sql.functions._ \r\n\r\n// Sett timezone to NO\r\nspark.conf.set(\"spark.sql.session.timeZone\", \"Europe/Oslo\")\r\n\r\n// Source paths\r\nval bil_base = \"/sparkio/trafikkdata/bil/*.csv\"\r\nval sykkel_base = \"/sparkio/trafikkdata/sykkel/*.csv\"\r\nval weather_base = \"/sparkio/værdata/*.csv\"\r\n\r\n// Defining Schemas\r\nval trafikk_Schema = StructType(Array(\r\n    StructField(\"trafikkregistreringspunkt\", StringType, true),\r\n\tStructField(\"navn\", StringType, true),\r\n\tStructField(\"vegreferanse\", StringType, true),\r\n\tStructField(\"fra\", TimestampType, true),\r\n\tStructField(\"til\", TimestampType, true),\r\n\tStructField(\"dato\", DateType, true),\r\n\tStructField(\"fra tidspunkt\", StringType, true),\r\n\tStructField(\"til tidspunkt\", StringType, true),\r\n\tStructField(\"felt\", StringType, true),\r\n\tStructField(\"trafikkmengde\", ShortType, true),\r\n\tStructField(\"dekningsgrad (%)\", StringType, true),\r\n\tStructField(\"antall timer total\", ByteType, true),\r\n\tStructField(\"antall timer inkludert\", ByteType, true),\r\n\tStructField(\"antall timer ugyldig\", ByteType, true),\r\n\tStructField(\"ikke gyldig lengde\", ByteType, true),\r\n\tStructField(\"lengdekvalitetsgrad (%)\", StringType, true),\r\n\tStructField(\"< 5,6m\", ShortType, true),\r\n\tStructField(\">= 5,6m\", ShortType, true),\r\n\tStructField(\"5,6m - 7,6m\", ShortType, true),\r\n\tStructField(\"7,6m - 12,5m\", ShortType, true),\r\n\tStructField(\"12,5m - 16,0m\", ShortType, true),\r\n\tStructField(\">= 16,0m\", ShortType, true),\r\n\tStructField(\"16,0m - 24,0m\", ShortType, true),\r\n\tStructField(\">= 24,0m\", ShortType, true)\r\n))\r\n\r\nval weather_Schema = StructType(Array(\r\n    StructField(\"navn\", StringType, true),\r\n\tStructField(\"stasjon\", StringType, true),\r\n\tStructField(\"tid(norsk normaltid)\", TimestampType, true),\r\n\tStructField(\"nedbør (1 t)\", StringType, true),\r\n\tStructField(\"lufttemperatur\", StringType, true),\r\n\tStructField(\"høyeste middelvind (1 t)\", StringType, true)\r\n))\r\n\r\n// Data import\r\nval bil_raw_df = spark.read\r\n    .option(\"header\", true)\r\n    .option(\"recursiveFileLookup\", true)\r\n    .schema(trafikk_Schema)\r\n    .option(\"delimiter\", \";\")\r\n    .option(\"nullValue\", \"-\")\r\n    .option(\"timestampFormat\", \"yyyy-MM-dd'T'HH:mmXXX\")    \r\n    .csv(bil_base)\r\n\r\nval sykkel_raw_df = spark.read\r\n    .option(\"header\", true)\r\n    .option(\"recursiveFileLookup\", true)\r\n    .schema(trafikk_Schema)\r\n    .option(\"delimiter\", \";\")\r\n    .option(\"nullValue\", \"-\")\r\n    .option(\"timestampFormat\", \"yyyy-MM-dd'T'HH:mmXXX\")    \r\n    .csv(sykkel_base)\r\n\r\nval weather_raw_df = spark.read\r\n    .option(\"header\", true)\r\n    .option(\"recursiveFileLookup\", true)\r\n    .schema(weather_Schema)\r\n    .option(\"delimiter\", \";\")\r\n    .option(\"nullValue\", \"-\")\r\n    .option(\"timestampFormat\", \"dd.MM.yyyy HH:mm\")\r\n    .csv(weather_base)\r\n\r\n// Data handeling\r\nval bil_raw = bil_raw_df.withColumn(\"klasse\", lit(0).cast(ByteType))\r\nval sykkel_raw = sykkel_raw_df.withColumn(\"klasse\", lit(1).cast(ByteType))\r\nval trafikk_raw_df = bil_raw.union(sykkel_raw)\r\n\r\nval trafikk_df_formatFix = trafikk_raw_df\r\n    .withColumn(\r\n        \"dekningsgrad (%)\",\r\n        regexp_replace(col(\"dekningsgrad (%)\"), \",\", \".\").cast(FloatType)\r\n    )\r\n    .withColumn(\r\n        \"lengdekvalitetsgrad (%)\",\r\n        regexp_replace(col(\"lengdekvalitetsgrad (%)\"), \",\", \".\").cast(FloatType)\r\n    )\r\n    .withColumn(\r\n        \"fra tidspunkt\",\r\n        date_format(col(\"fra\"), \"k\").cast(\"byte\")\r\n    )\r\n    .withColumn(\r\n        \"til tidspunkt\",\r\n        date_format(col(\"til\"), \"k\").cast(\"byte\")\r\n    )\r\n\r\nval weather_df_formatfix = weather_raw_df\r\n    .withColumn(\r\n        \"nedbør (1 t)\",\r\n        regexp_replace(col(\"nedbør (1 t)\"), \",\", \".\").cast(FloatType)\r\n    )\r\n    .withColumn(\r\n        \"lufttemperatur\",\r\n        regexp_replace(col(\"lufttemperatur\"), \",\", \".\").cast(FloatType)\r\n    )\r\n    .withColumn(\r\n        \"høyeste middelvind (1 t)\",\r\n        regexp_replace(col(\"høyeste middelvind (1 t)\"), \",\", \".\").cast(FloatType)\r\n    )\r\n\r\nval complete_df = trafikk_df_formatFix.alias(\"c\")\r\n    .join(weather_df_formatfix.alias(\"w\"),\r\n        col(\"c.fra\") === col(\"w.tid(norsk normaltid)\"),\"left\")\r\n    .select(\r\n        col(\"c.*\"),\r\n        col(\"w.lufttemperatur\"),\r\n        col(\"w.høyeste middelvind (1 t)\").as(\"høyeste middelvind (m/s)\")\r\n    )","user":"anonymous","dateUpdated":"2025-11-11T21:10:00+0000","progress":100,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"import spark.implicits._\nimport org.apache.spark.sql.types._\nimport org.apache.spark.sql.expressions._\nimport org.apache.spark.sql.functions._\n\u001b[1m\u001b[34mbil_base\u001b[0m: \u001b[1m\u001b[32mString\u001b[0m = /sparkio/trafikkdata/bil/*.csv\n\u001b[1m\u001b[34msykkel_base\u001b[0m: \u001b[1m\u001b[32mString\u001b[0m = /sparkio/trafikkdata/sykkel/*.csv\n\u001b[1m\u001b[34mweather_base\u001b[0m: \u001b[1m\u001b[32mString\u001b[0m = /sparkio/værdata/*.csv\n\u001b[1m\u001b[34mtrafikk_Schema\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.types.StructType\u001b[0m = StructType(StructField(trafikkregistreringspunkt,StringType,true),StructField(navn,StringType,true),StructField(vegreferanse,StringType,true),StructField(fra,TimestampType,true),StructField(til,TimestampType,true),StructField(dato,DateType,true),StructField(fra tidspunkt,StringType,true),StructField(til tidspunkt,StringType,true),StructFiel...\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762894782944_1826176745","id":"paragraph_1762894782944_1826176745","dateCreated":"2025-11-11T20:59:42+0000","dateStarted":"2025-11-11T21:10:00+0000","dateFinished":"2025-11-11T21:10:04+0000","status":"FINISHED","focus":false},{"text":"%spark\n","user":"anonymous","dateUpdated":"2025-11-11T21:02:14+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1762894934992_337077810","id":"paragraph_1762894934992_337077810","dateCreated":"2025-11-11T21:02:14+0000","status":"READY"}],"name":"2_Capstone_Frame_to_Table","id":"2MCDEGB6S","defaultInterpreterGroup":"spark","version":"0.12.0","noteParams":{},"noteForms":{},"angularObjects":{},"config":{"isZeppelinNotebookCronEnable":false,"looknfeel":"default","personalizedMode":"false"},"info":{},"path":"/2_Capstone_Frame_to_Table"}